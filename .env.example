# Hisab environment template
# Local: copy to `.env.local` or `.env`
# Vercel: see `.env.vercel.example` or Project Settings → Environment Variables

# --- Required ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
CRON_SECRET=generate_a_long_random_secret

# --- Optional ---
EXCHANGE_RATE_API_KEY=

# --- Local tooling only (do not add to Vercel) ---
# SUPABASE_DB_PASSWORD=
# DATABASE_URL=
# Transaction_Pooler=
# Direct_Connection=
# GITHUB_TOKEN=

# Legacy aliases still work locally via next.config.ts:
# SUPABASE_URL → NEXT_PUBLIC_SUPABASE_URL
# SUPABASE_ANON_KEY / SUPABASE_ANON_PUBLICK_KEY → NEXT_PUBLIC_SUPABASE_ANON_KEY
