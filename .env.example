# Hisab environment template
# Copy to `.env.local` or `.env` and fill in values from the Supabase project settings.
# Never commit real secrets. Never expose SUPABASE_SERVICE_ROLE_KEY to the browser.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Public site URL used for OAuth/password-reset redirects (production domain).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server only — do not prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Protects /api/cron/* routes (Vercel Cron sends Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=generate_a_long_random_secret

# Optional — used in later phases for live FX. Leave empty to use labeled dev fallback.
EXCHANGE_RATE_API_KEY=

# Optional — for Supabase CLI / direct SQL tooling only
# SUPABASE_DB_PASSWORD=
# DATABASE_URL=
